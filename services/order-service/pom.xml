<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ==================== PARENT REFERENCE ==================== -->
    <!-- Points to root pom. Inherits: Spring Boot parent, all BOMs,
         Lombok, spring-boot-starter-test, all plugin configs -->
    <parent>
        <groupId>com.finpay</groupId>
        <artifactId>finpay-intelligence</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- ==================== MODULE IDENTITY ==================== -->
    <artifactId>order-service</artifactId>
    <packaging>jar</packaging>
    <name>FinPay :: Order Service</name>
    <description>
        Order lifecycle management — CRUD, Saga orchestration,
        optimistic locking, HATEOAS REST API, JPA + Aurora PostgreSQL
    </description>

    <!-- ==================== ORDER-SERVICE DEPENDENCIES ==================== -->
    <dependencies>

        <!-- ── WEB LAYER ── -->

        <!-- Spring MVC REST + embedded Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- HATEOAS — adds _links to REST responses (RepresentationModel) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-hateoas</artifactId>
        </dependency>

        <!-- Bean Validation — @Valid, @NotNull, @Size, custom validators -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Swagger UI at /swagger-ui.html + OpenAPI JSON at /v3/api-docs -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <!-- version from dependencyManagement in root pom -->
        </dependency>

        <!-- ── SECURITY ── -->

        <!-- OAuth2 Resource Server — validate JWT from auth-service -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- ── DATA LAYER ── -->

        <!-- Spring Data JPA + Hibernate ORM -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC driver — connects to Aurora PostgreSQL -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <!-- version managed by spring-boot-starter-parent BOM -->
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway — database migration (V1__create_orders.sql etc) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Flyway PostgreSQL support (required from Flyway 10+) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ── SERVICE COMMUNICATION ── -->

        <!-- Spring Cloud OpenFeign — declarative HTTP client
             Used by PaymentClient + FraudClient to call other services -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <!-- version from spring-cloud-dependencies BOM -->
        </dependency>

        <!-- ── OBSERVABILITY ── -->

        <!-- Actuator — /actuator/health, /actuator/metrics, /actuator/info -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Micrometer CloudWatch — push custom metrics to CloudWatch -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-cloudwatch2</artifactId>
        </dependency>

        <!-- ── MAPPING ── -->

        <!-- MapStruct — compile-time DTO <-> Entity mapper -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <!-- ── TESTING ── -->

        <!-- Testcontainers core -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers PostgreSQL module — spins real Postgres in Docker -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers JUnit5 integration — @Testcontainers, @Container -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pact consumer contract testing — order-service as consumer of payment-service -->
        <dependency>
            <groupId>au.com.dius.pact.consumer</groupId>
            <artifactId>junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- WireMock — mock payment-service + fraud-service in integration tests -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-contract-wiremock</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2 in-memory DB — fast unit tests without Testcontainers -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ==================== BUILD ==================== -->
    <build>
        <plugins>

            <!-- Package as executable fat JAR for Docker -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- config inherited from root pluginManagement -->
            </plugin>

            <!-- Compiler — inherited config (Java 17 + Lombok + MapStruct) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- Failsafe — runs *IT.java integration tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>